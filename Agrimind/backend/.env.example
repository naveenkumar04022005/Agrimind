# Agrimind Backend Environment Variables

# Application
PROJECT_NAME="Agrimind API"
VERSION="1.0.0"
API_V1_STR="/api"

# Local PostgreSQL Database
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg://agrimind:agrimind_password@localhost:5432/agrimind

# Docker Compose PostgreSQL Settings
POSTGRES_DB=agrimind
POSTGRES_USER=agrimind
POSTGRES_PASSWORD=agrimind_password
POSTGRES_PORT=5432

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_random_secret_key_for_production_use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Weather Telemetry (Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# File Uploads Directory
UPLOAD_DIR=uploads
